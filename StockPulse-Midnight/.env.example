# Copy this file to .env. Never share a file containing your actual API key.
GEMINI_API_KEY=
# Use a model currently available to your own Google AI Studio project.
GEMINI_MODEL=
# Optional: generated and saved locally when empty.
SECRET_KEY=
# 0 = real provider data; 1 = clearly labelled illustrative preview data.
STOCKPULSE_DEMO=0
PORT=5000

# Keep web training disabled on public hosting. Enable locally for an existing owner only.
ENABLE_WEB_TRAINING=0
ADMIN_USER_IDS=
# Set to 1 only when serving through HTTPS; keep 0 for localhost HTTP.
SESSION_COOKIE_SECURE=0
